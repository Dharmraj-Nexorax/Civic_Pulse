# Database Configuration (MySQL)
DATABASE_URL=mysql://civicpulse:civicpulse@127.0.0.1:3306/civicpulse
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=civicpulse
MYSQL_PASSWORD=civicpulse
MYSQL_DATABASE=civicpulse

# Authentication
JWT_SECRET=change-me-min-32-chars-long-secret-key-civicpulse
COOKIE_NAME=cp_token
COOKIE_MAX_AGE_SECONDS=604800

# File Storage
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=10
MAX_VIDEO_MB=25
MAX_FILES_PER_COMPLAINT=5

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_INTERNAL_KEY=change-me-shared-secret
AI_TIMEOUT_MS=4000

# Organization & Seed Defaults
DEFAULT_ORGANIZATION_SLUG=demo-panchayat
SEED_ADMIN_NAME=Admin
SEED_ADMIN_MOBILE=9876543210
SEED_ADMIN_EMAIL=admin@civicpulse.org
